{
  "name": "@icp/contracts",
  "version": "2.0.0",
  "private": true,
  "description": "Shared API contract: OpenAPI document exported from the FastAPI backend and generated TypeScript types.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
