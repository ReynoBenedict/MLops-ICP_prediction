# ---------------------------------------------------------------------------------------------
# ICP platform - backend environment template.
# Copy to `.env` for local development (`npm run setup` does this for you). `.env` is gitignored.
# In deployment, set these in the platform's environment/secret store (Render env vars, `wrangler
# secret put`) instead of using a file. Zero-cost topology: docs/DEPLOYMENT.md.
# Full matrix (local / test / staging / production): docs/ENVIRONMENTS.md
# ---------------------------------------------------------------------------------------------

# local | test | staging | production   (staging/production enforce strict validation)
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# --- Application metadata store ------------------------------------------------------------
# sqlite (local file) | d1 (Cloudflare D1 via REST API + token) | d1_gateway (D1 through the
# gateway Worker's internal data plane; the zero-cost deployment, no Cloudflare API token needed)
METADATA_BACKEND=sqlite
SQLITE_PATH=var/metadata.db
# D1_ACCOUNT_ID=<cloudflare-account-id>
# D1_DATABASE_ID=<d1-database-uuid>
# D1_API_TOKEN=<api-token-with-D1-edit-permission>
# Worker origin for d1_gateway / gateway backends (requests carry GATEWAY_SHARED_SECRET):
# GATEWAY_INTERNAL_URL=https://icp-gateway-staging.<account-subdomain>.workers.dev

# --- Object store ----------------------------------------------------------------------------
# local (filesystem) | s3 (Cloudflare R2 S3-compatible API) | gateway (Cloudflare KV through the
# gateway Worker; zero-cost deployment)
OBJECT_STORE_BACKEND=local
LOCAL_OBJECT_DIR=var/objects
# S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# S3_BUCKET=<r2-bucket-name>
# S3_REGION=auto
# S3_ACCESS_KEY_ID=<r2-access-key-id>
# S3_SECRET_ACCESS_KEY=<r2-secret-access-key>

# --- Model source ----------------------------------------------------------------------------
# mlflow (registry alias; training/promotion available) | bundle (exported bundle in the object
# store written by `icp-api export-model`; no MLflow online, training/promotion refused with 409)
MODEL_SOURCE=mlflow

# --- MLflow (experiment tracking + model registry; operator machine / MODEL_SOURCE=mlflow) ----
# Local default: sqlite:///var/mlflow/mlflow.db (absolute path is derived automatically when unset).
# Deployed with MODEL_SOURCE=mlflow: PostgreSQL + artifacts in R2 (paid-tier topology, see docs).
# MLFLOW_TRACKING_URI=postgresql+psycopg2://<user>:<password>@<host>:5432/<db>
# MLFLOW_ARTIFACT_ROOT=s3://<r2-bucket-name>/mlflow
# MLFLOW_S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
# AWS_ACCESS_KEY_ID=<r2-access-key-id>
# AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
# AWS_DEFAULT_REGION=auto
MODEL_NAME=ICP_Price_Model
MODEL_ALIAS=production
TRAINING_CONFIG_PATH=pipeline/configs/training.yaml
MODEL_REFRESH_SECONDS=30
SEED_FROM_REPOSITORY=true
# Seed CSVs for benchmarks/FX when no active version exists (exported from public sources, see docs/DATA_SOURCES.md)
SEED_DIR=data/seed

# --- Security --------------------------------------------------------------------------------
# Admin bearer tokens as name:token pairs (comma separated). Generate with: icp-api new-token
# Leave empty to disable all admin operations. Never commit real tokens.
ADMIN_API_TOKENS=
# Shared secret the Cloudflare Worker sends in X-Gateway-Secret. Required (>= 32 chars) when deployed.
GATEWAY_SHARED_SECRET=
REQUIRE_GATEWAY_SECRET=false
# Bearer token for /metrics: optional locally, required (>= 32 chars) when APP_ENV is staging/production
METRICS_TOKEN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
MAX_REQUEST_BYTES=2000000
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FORECAST_PER_MINUTE=30
RATE_LIMIT_ADMIN_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Background jobs -------------------------------------------------------------------------
JOB_MAX_CONCURRENT=1
JOB_TIMEOUT_TRAIN_SECONDS=1800
JOB_TIMEOUT_INGEST_SECONDS=300
JOB_HEARTBEAT_SECONDS=10
JOB_STALE_AFTER_SECONDS=120

# --- Optional ------------------------------------------------------------------------------
# EXPOSE_API_DOCS=true
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   (only for `icp-ml ingest-icp-pdf`)
