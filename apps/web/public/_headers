# Response headers for static assets served by Cloudflare Workers Static Assets.
# (API responses get their headers from the gateway Worker and the backend.)
# Everything the site loads is same-origin: scripts and styles from /assets, self-hosted fonts from
# /fonts, images from /img and /brand, data from /api. No third-party origin is allowed anywhere.
# - style-src keeps 'unsafe-inline' for React/SVG style attributes (residual, docs/SECURITY.md).
# - No Strict-Transport-Security on static assets while the site runs on *.workers.dev: the .dev TLD is
#   HSTS-preloaded in browsers and the Worker's /api answers already send it; add it here together with
#   a custom domain (residual SEC-15, docs/SECURITY.md).
# - Cross-Origin-Opener-Policy isolates the browsing context from any window that opens it (no popups
#   or OAuth windows are used); Cross-Origin-Resource-Policy stops other sites embedding our files.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'self'; frame-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), browsing-topics=()

# Content-hashed by Vite: a new build gets new names.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: the version is part of every file name (e.g. ibm-plex-sans-var-latin-5.3.0.woff2);
# a font update must ship under a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/brand/*
  Cache-Control: public, max-age=604800
