// Cloudflare Worker configuration for the ICP gateway (web app + /api proxy + internal data plane).
// Nothing here is deployed by the repository's scripts. See docs/DEPLOYMENT.md before running
// `wrangler deploy --env staging|production`.
//
// Zero-cost topology (docs/DEPLOYMENT.md): the Worker also binds D1 (`DB`) and KV (`OBJECTS`) and
// exposes them to the Python backend under /api/internal/* behind the shared secret, so the
// backend needs no Cloudflare API token. All of this stays inside the Workers Free plan
// (Workers 100k req/day, D1 5M reads + 100k writes/day, KV 100k reads + 1k writes/day; hard stops,
// no charges). Bindings are per environment and are NOT inherited from the top level.
//
// The Worker also keeps last-known-good copies of the two anonymous public answers in the same KV
// namespace under the reserved prefix `edge-cache/` (written when the content changes, at most once per
// key per 5 minutes, and an unchanged copy once a day; the data plane refuses that prefix). No extra
// binding is needed.
//
// Production values are placeholders (<...>) until those resources are created.
// Secrets are NOT stored here: set GATEWAY_SHARED_SECRET with
//   npx wrangler secret put GATEWAY_SHARED_SECRET --env staging|production
// For local `wrangler dev`, put it in apps/gateway/.dev.vars (gitignored; created by `npm run setup`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icp-gateway-local",
  "main": "src/worker.ts", // exports only the handler (see the comment in that file)
  "compatibility_date": "2026-09-30",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs first for /api/* and for pages (the SPA document: it starts the serverless backend
    // early, see src/index.ts `warmBackend`). Static files are served directly and never invoke the Worker
    // (free and unlimited): every top-level folder/file of apps/web/public plus Vite's /assets must be
    // excluded here; test/resilience.test.ts checks that list against apps/web/public.
    "run_worker_first": ["/*", "!/assets/*", "!/brand/*", "!/fonts/*", "!/img/*", "!/favicon.svg"]
  },
  // Local development: the backend started by `npm run dev:edge`.
  "vars": {
    "ENVIRONMENT": "local",
    "BACKEND_URL": "http://127.0.0.1:8000",
    "MAX_BODY_BYTES": "2000000",
    "UPSTREAM_TIMEOUT_MS": "30000",
    // Anonymous GET /api/v1/public/market-snapshot and /api/v1/plans: shorter than the browser's 10 s
    // public timeout, so the gateway answers first (live, the last-known-good copy from KV, or an error).
    "PUBLIC_UPSTREAM_TIMEOUT_MS": "8000"
  },
  // Edge rate limits (period must be 10 or 60 seconds). namespace_id values are chosen by you and must
  // be unique positive integers within the Cloudflare account; change them if they collide.
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "41001", "simple": { "limit": 300, "period": 60 } },
    { "name": "FORECAST_RATE_LIMITER", "namespace_id": "41002", "simple": { "limit": 20, "period": 60 } }
  ],
  "env": {
    "staging": {
      "name": "icp-gateway-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        // Backend origin: the production domain of the Vercel project `icp-api-staging` (Vercel Hobby,
        // serverless; docs/DEPLOYMENT.md). It is stable across deploys, so it lives here and nowhere else.
        // Set it once after the first backend deploy with `node scripts/vercel-backend.mjs
        // --write-gateway-url` (or by hand), then `npx wrangler deploy --env staging`. While this is a
        // placeholder the gateway answers 503 GATEWAY_MISCONFIGURED for /api/v1/* (assets and data plane
        // still work). Manual fallback: `npm run staging:backend` (laptop + Quick Tunnel) overrides it for
        // one deploy with `--var BACKEND_URL:<tunnel>`; a plain deploy returns to this value.
        "BACKEND_URL": "https://icp-api-staging.vercel.app",
        "MAX_BODY_BYTES": "2000000",
        // A cold serverless start is the imports (about 2.1-2.5 s locally) plus, by default, Vercel's install of
        // the dependencies that do not fit inside the function (estimated several seconds; docs/DEPLOYMENT.md
        // "Size of the function"); the function itself is capped at 60 s (infra/vercel/vercel.json). 90 s stays
        // above both, below Cloudflare's 100 s subrequest limit and the browser's 95 s report timeout.
        "UPSTREAM_TIMEOUT_MS": "90000",
        // Public data does not wait for a cold start: after 8 s the last-known-good copy kept in the
        // OBJECTS KV namespace (edge-cache/public/*) is served, marked stale (docs/OPERATIONS.md).
        "PUBLIC_UPSTREAM_TIMEOUT_MS": "8000"
      },
      // Daily at 22:17 UTC (05:17 WIB): refresh the two last-known-good public copies through the normal
      // path, so the landing page has current figures even when nobody visited (2 backend invocations per
      // day). Workers Free allows 5 Cron Triggers per account. No frequent keep-warm on purpose.
      "triggers": { "crons": ["17 22 * * *"] },
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "41011", "simple": { "limit": 300, "period": 60 } },
        { "name": "FORECAST_RATE_LIMITER", "namespace_id": "41012", "simple": { "limit": 20, "period": 60 } }
      ],
      // Created with `npx wrangler d1 create icp-metadata-staging` / `npx wrangler kv namespace create icp-objects-staging`
      // (free). Schema: `npx wrangler d1 migrations apply icp-metadata-staging --remote -c infra/cloudflare/d1/wrangler.jsonc`.
      "d1_databases": [
        { "binding": "DB", "database_name": "icp-metadata-staging", "database_id": "15fece89-2034-4f83-bc45-a308023e16f4" }
      ],
      "kv_namespaces": [
        { "binding": "OBJECTS", "id": "067677c60b6946949ed2ff3cf518ea7a" }
      ]
    },
    "production": {
      "name": "icp-gateway",
      "vars": {
        "ENVIRONMENT": "production",
        "BACKEND_URL": "https://<render-production-service>.onrender.com",
        "MAX_BODY_BYTES": "2000000",
        "UPSTREAM_TIMEOUT_MS": "90000",
        "PUBLIC_UPSTREAM_TIMEOUT_MS": "8000"
      },
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "41021", "simple": { "limit": 300, "period": 60 } },
        { "name": "FORECAST_RATE_LIMITER", "namespace_id": "41022", "simple": { "limit": 20, "period": 60 } }
      ],
      // Create separate production resources (`wrangler d1 create icp-metadata`, `wrangler kv namespace
      // create icp-objects`) and fill in the ids; `wrangler deploy --env production` is refused until then.
      "d1_databases": [
        { "binding": "DB", "database_name": "icp-metadata", "database_id": "<D1_PRODUCTION_DATABASE_ID>" }
      ],
      "kv_namespaces": [
        { "binding": "OBJECTS", "id": "<KV_PRODUCTION_NAMESPACE_ID>" }
      ]
      // "routes": [{ "pattern": "<your-custom-domain>", "custom_domain": true }]
    }
  }
}
