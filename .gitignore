# --- Local secrets (never commit) -------------------------------------------------------------
.env
.env.*
!.env.example
.dev.vars
.dev.vars*
!.dev.vars.example

# --- Runtime state & generated artifacts --------------------------------------------------------
# var/ holds the local metadata DB, object store, MLflow store, backups and logs.
var/
mlruns/
mlartifacts/
mlflow.db
*.log
/reports/
data/processed/*.txt
data/processed/features.csv

# Raw data is tracked by DVC (data/raw.dvc, data/processed.dvc); see data/.gitignore.
data/raw/*.pdf

# --- Python ----------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
.ipynb_checkpoints

# --- Node / Cloudflare ------------------------------------------------------------------------
node_modules/
dist/
.wrangler/
*.tsbuildinfo
apps/gateway/worker-configuration.d.ts

# --- Editors & OS -----------------------------------------------------------------------------
.idea/workspace.xml
.idea/shelf/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
