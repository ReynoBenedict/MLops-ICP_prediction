# =============================================================
# Dockerfile.serving — FastAPI Model Serving (ICP Price Model)
# Model loaded at runtime from MLflow Registry — NOT baked in.
# =============================================================

FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# curl needed for Docker healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python dependencies
COPY requirements.serving.txt .
RUN pip install --no-cache-dir --default-timeout=100 -r requirements.serving.txt

# Application code (serving layer only — no model artifacts)
COPY serving/ ./serving/

EXPOSE 8000

CMD ["uvicorn", "serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
